[Unit]
AssertPathExists={{ caddy_service_dir }}/conf/Caddyfile
Wants=network-online.target
After=network-online.target
RequiresMountsFor=/run/user/{{ caddy_uid }}/containers

[Container]
ContainerName={{ caddy_container_name }}
Image={{ caddy_image }}
Network=pasta
AddDevice=/dev/fuse
LogDriver=journald

# Pull behavior
Pull=newer
AutoUpdate=registry

# Ports
{% for port in caddy_container_ports %}
PublishPort={{ port }}
{% endfor %}

# Volumes
{% for volume in caddy_volumes %}
{% set options = volume.options | default([]) + (['Z'] if ansible_facts.selinux.status | default('disabled') == 'enabled' else []) +%}
Volume={{ volume.host_path }}:{{ volume.container_path }}{% if options %}:{{ options | join(',') }}{% endif %}
{% endfor %}

[Service]
Restart=always
RestartSec=10
TimeoutStartSec=60
TimeoutStopSec=30

[Install]
WantedBy=default.target
